# Copy the variables below into .env.local (git-ignored). Never commit real values.

SUPABASE_URL=https://cvisycdcnrjcrxlexldc.supabase.co
# Dashboard > Project Settings > API Keys > Secret (sb_secret_...). Server-only: bypasses RLS.
SUPABASE_SECRET_KEY=
# Same page > Publishable (sb_publishable_...). Safe for reads; the website uses it.
SUPABASE_PUBLISHABLE_KEY=

# Mercado Livre app credentials (developers.mercadolivre.com.br)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Optional until your affiliate account is approved. {url} is the product link.
# Example shape only: ML_AFFILIATE_URL_TEMPLATE={url}?your_param=your_value
ML_AFFILIATE_URL_TEMPLATE=

# --- Telegram (my.telegram.org > API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generated once by: npm run engine:tg-login (use a SECONDARY account)
TELEGRAM_SESSION=
# Channel usernames you follow, comma-separated, e.g. promocoes_br,achadinhos
TELEGRAM_CHANNELS=
TELEGRAM_MESSAGES_PER_CHANNEL=50

# --- Your affiliate IDs (leave empty until approved) ---
AMAZON_ASSOCIATE_TAG=
SHOPEE_AFFILIATE_URL_TEMPLATE=
